# =====================================================================
# InternScrap Environment Configuration Template
# Copy this file to .env and customize for your local or cloud environment.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///./jobs.db

# Production Free-Tier (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection:
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# CORS & Networking
# ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://internscrap.vercel.app

# ---------------------------------------------------------------------
# APScheduler & Background Sync
# ---------------------------------------------------------------------
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=4
ALERT_MIN_MATCH_SCORE=70.0

# ---------------------------------------------------------------------
# Email Digest & SMTP Notifications (Optional)
# ---------------------------------------------------------------------
DIGEST_RECIPIENT_EMAIL=candidate@example.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_mailgun_secret_key
SMTP_FROM_EMAIL=alerts@internscrap.dev
SMTP_USE_TLS=true

# ---------------------------------------------------------------------
# Optional External API Keys (Defaults fallback to free public feeds)
# ---------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTE_OK_ENABLED=true
ARBEITNOW_ENABLED=true
JOBICY_ENABLED=true
GITHUB_INTERNSHIP_ENABLED=true

# ---------------------------------------------------------------------
# Frontend Environment Variable (Set in Vercel or frontend/.env)
# ---------------------------------------------------------------------
# VITE_API_URL=https://your-backend.onrender.com/api
